# Obsidian 工作区状态
.obsidian/

# Python 缓存
__pycache__/
*.py[cod]
*$py.class

# 系统/编辑器临时文件
.DS_Store
Thumbs.db
*.swp
*~

# 官方评估脚本在未指定 --trace-output/--log-output 时，
# 会把调试文件写在 data/ 用例旁边；data/ 只读，这些文件不应入库。
data/case_*_problem_*_log.txt
data/case_*_problem_*_trace.json

# 复核脚本用的临时目录（tempfile.TemporaryDirectory 未清理时残留）
results/tmp*/
